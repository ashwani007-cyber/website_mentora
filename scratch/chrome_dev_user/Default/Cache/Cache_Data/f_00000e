// IndexedDB storage for document files (PDFs)
const IDB_NAME = "RegistryDocStore_v2";
const IDB_STORE = "documents";
let cachedIDB = null;
function openDocDB() {
	if (typeof window === "undefined" || !window.indexedDB) {
		return Promise.resolve(null);
	}
	if (cachedIDB) {
		try {
			if (cachedIDB.objectStoreNames.contains(IDB_STORE)) {
				return Promise.resolve(cachedIDB);
			}
		} catch {}
		cachedIDB = null;
	}
	return new Promise((resolve) => {
		try {
			const request = window.indexedDB.open(IDB_NAME, 1);
			request.onupgradeneeded = () => {
				const db = request.result;
				if (!db.objectStoreNames.contains(IDB_STORE)) {
					db.createObjectStore(IDB_STORE, { keyPath: "id" });
				}
			};
			request.onsuccess = () => {
				const db = request.result;
				if (!db.objectStoreNames.contains(IDB_STORE)) {
					db.close();
					const upReq = window.indexedDB.open(IDB_NAME, (db.version || 1) + 1);
					upReq.onupgradeneeded = () => {
						const upDb = upReq.result;
						if (!upDb.objectStoreNames.contains(IDB_STORE)) {
							upDb.createObjectStore(IDB_STORE, { keyPath: "id" });
						}
					};
					upReq.onsuccess = () => {
						cachedIDB = upReq.result;
						resolve(cachedIDB);
					};
					upReq.onerror = () => resolve(null);
					return;
				}
				cachedIDB = db;
				resolve(db);
			};
			request.onerror = () => resolve(null);
		} catch {
			resolve(null);
		}
	});
}
export async function storeDocFile(id, fileData, meta) {
	if (!id || !fileData) return;
	// 1. In-memory cache
	if (typeof window !== "undefined") {
		window.__docDataCache = window.__docDataCache || {};
		window.__docDataCache[id] = fileData;
		if (meta?.fileName) {
			const fn = meta.fileName.toLowerCase().trim();
			window.__docDataCache[`file-${fn}`] = fileData;
			window.__docDataCache[meta.fileName] = fileData;
			window.__docDataCache[fn] = fileData;
		}
		if (meta?.expertName && meta?.type) {
			window.__docDataCache[`doc-${meta.expertName.toLowerCase().trim()}-${meta.type}`] = fileData;
		}
		if (meta?.expertEmail && meta?.type) {
			window.__docDataCache[`doc-${meta.expertEmail.toLowerCase().trim()}-${meta.type}`] = fileData;
		}
		if (meta?.expertId && meta?.type) {
			window.__docDataCache[`doc-${meta.expertId.toLowerCase().trim()}-${meta.type}`] = fileData;
		}
	}
	// 2. Dedicated synchronous localStorage and sessionStorage keys
	if (typeof window !== "undefined") {
		try {
			if (meta?.fileName) {
				const fn = meta.fileName.toLowerCase().trim();
				safeSetItem(`doc_bin_${fn}`, fileData);
				try {
					sessionStorage.setItem(`doc_bin_${fn}`, fileData);
				} catch {}
			}
			safeSetItem(`doc_bin_${id}`, fileData);
			try {
				sessionStorage.setItem(`doc_bin_${id}`, fileData);
			} catch {}
			if (meta?.expertId && meta?.type) {
				safeSetItem(`doc_bin_${meta.expertId}_${meta.type}`, fileData);
			}
			if (meta?.expertName && meta?.type) {
				safeSetItem(`doc_bin_${meta.expertName.toLowerCase().trim()}_${meta.type}`, fileData);
			}
			if (meta?.expertEmail && meta?.type) {
				safeSetItem(`doc_bin_${meta.expertEmail.toLowerCase().trim()}_${meta.type}`, fileData);
			}
		} catch {}
	}
	// 3. IndexedDB
	try {
		const db = await openDocDB();
		if (db) {
			await new Promise((resolve) => {
				try {
					const tx = db.transaction(IDB_STORE, "readwrite");
					const store = tx.objectStore(IDB_STORE);
					store.put({
						id,
						fileData,
						fileName: meta?.fileName,
						expertId: meta?.expertId,
						expertName: meta?.expertName,
						expertEmail: meta?.expertEmail,
						type: meta?.type,
						updatedAt: Date.now()
					});
					if (meta?.fileName) {
						store.put({
							id: `file-${meta.fileName.toLowerCase().trim()}`,
							fileData,
							fileName: meta?.fileName,
							expertId: meta?.expertId,
							expertName: meta?.expertName,
							expertEmail: meta?.expertEmail,
							type: meta?.type,
							updatedAt: Date.now()
						});
					}
					tx.oncomplete = () => resolve();
					tx.onerror = () => resolve();
				} catch {
					resolve();
				}
			});
		}
	} catch {}
	// 4. Server API upload so files persist across all sessions, tabs, and origins permanently
	if (typeof window !== "undefined") {
		try {
			fetch("/api/documents", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					id,
					fileName: meta?.fileName,
					fileData,
					expertId: meta?.expertId,
					expertName: meta?.expertName,
					expertEmail: meta?.expertEmail,
					type: meta?.type
				})
			}).catch(() => {});
		} catch {}
	}
}
