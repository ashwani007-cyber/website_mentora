	getExpertDocuments(idOrEmailOrName) {
		if (!idOrEmailOrName) return null;
		const query = idOrEmailOrName.trim().toLowerCase();
		const raw = localStorage.getItem("mongo_expert_documents");
		const records = raw ? JSON.parse(raw) : {};
		const enrichRecordWithFileBinaries = (r) => {
			if (!r || !r.docs) return r;
			const slots = [
				"expCert",
				"offerLetter",
				"resume"
			];
			let sessionItems = null;
			try {
				const cur = localStorage.getItem("current_logged_in_expert") || localStorage.getItem("admin_logged_in_expert");
				if (cur) {
					const p = JSON.parse(cur);
					if (p?.documents?.items) sessionItems = p.documents.items;
				}
			} catch {}
			for (const slot of slots) {
				const d = r.docs[slot];
				if (d && (!d.fileData || !d.fileData.startsWith("data:"))) {
					const fn = d.fileName ? d.fileName.toLowerCase().trim() : "";
					const fromSession = sessionItems?.[slot]?.fileData && sessionItems[slot].fileData.startsWith("data:") ? sessionItems[slot].fileData : null;
					const found = fromSession || (fn ? localStorage.getItem(`doc_bin_${fn}`) || sessionStorage.getItem(`doc_bin_${fn}`) : null) || (d.id ? localStorage.getItem(`doc_bin_${d.id}`) || sessionStorage.getItem(`doc_bin_${d.id}`) : null) || (r.expertId ? localStorage.getItem(`doc_bin_${r.expertId}_${slot}`) || sessionStorage.getItem(`doc_bin_${r.expertId}_${slot}`) : null) || (r.expertName ? localStorage.getItem(`doc_bin_${r.expertName.toLowerCase().trim()}_${slot}`) || sessionStorage.getItem(`doc_bin_${r.expertName.toLowerCase().trim()}_${slot}`) : null) || (r.expertEmail ? localStorage.getItem(`doc_bin_${r.expertEmail.toLowerCase().trim()}_${slot}`) || sessionStorage.getItem(`doc_bin_${r.expertEmail.toLowerCase().trim()}_${slot}`) : null);
					if (found && found.startsWith("data:")) {
						d.fileData = found;
					}
				}
			}
			return r;
		};
		// 1. Direct key match (by expertId, email, or name)
		if (records[idOrEmailOrName]) {
			return enrichRecordWithFileBinaries(records[idOrEmailOrName]);
		}
		if (records[query]) {
			return enrichRecordWithFileBinaries(records[query]);
		}
		// 2. Value scan (by expertId, expertEmail, or expertName)
		for (const key of Object.keys(records)) {
			const rec = records[key];
			if (rec.expertId?.toLowerCase() === query || rec.expertEmail?.toLowerCase() === query || rec.expertName?.toLowerCase().trim() === query) {
				return enrichRecordWithFileBinaries(rec);
			}
		}
		// 3. Check mongo_pending_verifications: If query matches an audit case ID or applicant
		const pendRaw = localStorage.getItem("mongo_pending_verifications");
		if (pendRaw) {
			try {
				const pendings = JSON.parse(pendRaw);
				const item = pendings.find((p) => p.id.toLowerCase() === query || p.name.toLowerCase().trim() === query || p.email && p.email.toLowerCase() === query);
				if (item) {
					// Priority A: Check if records already has a real uploaded record matching this person
					const existingRealRec = Object.values(records).find((r) => r.expertName && item.name && r.expertName.toLowerCase().trim() === item.name.toLowerCase().trim() || r.expertEmail && item.email && r.expertEmail.toLowerCase().trim() === item.email.toLowerCase().trim() || r.expertId && item.id && r.expertId.toLowerCase() === item.id.toLowerCase());
					if (existingRealRec) {
						records[item.id] = existingRealRec;
						safeSetItem("mongo_expert_documents", JSON.stringify(records));
						return enrichRecordWithFileBinaries(existingRealRec);
					}
					// Priority B: If item.documents?.items has uploaded document items
					if (item.documents && item.documents.items) {
						const items = item.documents.items;
						if (items.expCert || items.offerLetter || items.resume) {
							const recFromPending = {
